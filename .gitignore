# Build artifacts
DerivedData/
.build/
*.xcodeproj/
*.xcworkspace/
*.swp
.DS_Store

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcuserdatad/

# SPM
Packages/*/.build/
.swiftpm/

# Temp / logs
/tmp/aidash-*
*.log

# Runtime state (snapshots / cron output — regenerated, not source)
.aidash-state/

# Editor
.vscode/
.idea/

# 本机身份覆盖(Bundle ID / CloudKit 容器 / Apple Team ID)。
# 模板:Configs/Identity.local.xcconfig.example
Configs/Identity.local.xcconfig

# OS
Thumbs.db

# ---------------------------------------------------------------------------
# aidata (Python 数据层)
# 全部规则显式锚定到 aidata/ —— 不加前缀会误伤全仓库同名文件（如 state.json）。
# ---------------------------------------------------------------------------

# 数据层：含 PII / secrets，永不提交
aidata/L1_collect/raw/
aidata/L2_normalize/clean/
aidata/L3_merge/*.db
aidata/L3_merge/*.db-wal
aidata/L3_merge/*.db-shm
aidata/state.json

# 机器本地配置覆盖（账号 / 雇主 / workspace 标识符）。模板：config_local.example.py
aidata/config_local.py

# digest 归档输出（生成物）
aidata/L5_apps/digest/archive/

# M3 action-inbox 运行时状态（agent 追加写；example 才是 schema 文档）
aidata/L5_apps/digest/state/proposals.jsonl

# radar LLM 富化缓存（每机一份，内容寻址，可重建）
aidata/L5_apps/digest/state/repo_enrichment.json

# SDD 草稿（ledger / task brief）
aidata/.superpowers/

# Python（全仓库通用）
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.ruff_cache/
