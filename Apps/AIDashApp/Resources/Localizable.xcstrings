    "dashboard.action.default_digest_summary": {
      "comment": "Default action item summary when all metrics are healthy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All CLI quotas and system telemetry are within healthy thresholds today."
