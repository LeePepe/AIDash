    "briefing.scene.error.status": {
      "comment": "Status shown when the BriefingWindowScene cannot initialize its CloudKit store.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ERROR"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "错误"
          }
        }
      }
    },
    "briefing.scene.error.subtitle": {
      "comment": "Supporting copy shown when the BriefingWindowScene cannot initialize its CloudKit store.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check iCloud and try opening the briefing again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请检查 iCloud，然后重新打开简报。"
          }
        }
      }
    },
    "briefing.scene.error.title": {
      "comment": "Title shown when the BriefingWindowScene cannot initialize its CloudKit store.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Briefing unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简报不可用"
          }
        }
      }
    },
