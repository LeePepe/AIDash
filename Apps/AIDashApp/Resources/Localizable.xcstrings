    "briefing.storage_unavailable.title": {
      "comment": "Title shown in the BriefingWindowScene fallback when CloudKit container init fails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud unavailable"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 不可用"
          }
        }
      }
    },
    "cloudkit.unavailable.message": {
      "comment": "Shown in the iCloud unavailable scene when SwiftData CloudKit init fails.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud data sync is unavailable. Please check your iCloud account in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 数据同步不可用，请在系统设置中检查 iCloud 账号状态。"
          }
        }
      }
    },
    "dashboard.action.default_codex_summary": {
      "comment": "Default action item summary for Codex CLI check.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify zero pending retries across automated PR review gates."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认自动化 PR 审查门禁无排队重试任务。"
          }
        }
      }
    },
    "dashboard.action.default_codex_title": {
      "comment": "Default action item title for Codex CLI check.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
