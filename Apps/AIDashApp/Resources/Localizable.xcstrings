        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待办与 Issue 同步集成"
          }
        }
      }
    },
    "settings.todo_sync.mode.auto": {
      "comment": "Option title for automatic TodoSyncProvider selection.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto (Linear when configured, else Local)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动识别（已配置时使用 Linear，否则本地独立运行）"
          }
        }
      }
    },
    "settings.todo_sync.mode.auto_desc": {
      "comment": "Description for automatic TodoSyncProvider selection.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Linear SSOT when linear-sync.py is installed and falls back to standalone local todos otherwise"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到本机配置 linear-sync.py 时自动启用 Linear SSOT，未安装时自动回退到本地独立模式"
          }
        }
      }
    },
    "settings.todo_sync.mode.linear": {
      "comment": "Option title for Linear SSOT sync mode.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linear SSOT Sync Mode"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Linear 统一事实源模式 (SSOT)"
          }
        }
      }
    },
    "settings.todo_sync.mode.linear_desc": {
      "comment": "Description for Linear SSOT sync mode.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Promotes starred proposals to Linear and bidirectionally syncs Done / Todo status with your Linear team"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将星标提案自动建单到 Linear，并与 Linear 团队双向同步完成 / 待办状态"
          }
        }
      }
    },
    "settings.todo_sync.mode.local": {
      "comment": "Option title for standalone local-only todo sync mode.",
      "extractionState": "manual",
