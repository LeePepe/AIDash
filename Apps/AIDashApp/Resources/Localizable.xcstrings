    },
    "dashboard.action.default_digest_summary": {
      "comment": "Default action item summary when all metrics are healthy.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All CLI quotas and system telemetry are within healthy thresholds today."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前所有 CLI 配额与本机系统状态均在健康范围内。"
          }
        }
      }
    },
    "dashboard.action.default_digest_title": {
      "comment": "Default action item title for daily agent digest check.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review daily agent efficiency & token volume"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查今日 Agent 执行效率与 Token 总量"
          }
        }
      }
    },
    "dashboard.action.memory_pressure_detail_format": {
      "comment": "Actionable instructions for memory pressure warning item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used %@. Click 'Copy' to inspect top processes in Terminal, or click circle to dismiss."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已用 %@。点右侧「复制命令」可在终端查看内存前10进程，或点左侧圆圈忽略。"
          }
        }
      }
    },
    "dashboard.action.memory_pressure_summary": {
      "comment": "Summary for memory pressure warning action item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close idle simulator runtimes or background indexing workers to reclaim wired memory."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议关闭空闲模拟器或后台索引进程以释放常驻内存。"
          }
        }
      }
    },
    "dashboard.action.memory_pressure_title_format": {
      "comment": "Title format for memory pressure warning action item showing percent and top process.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory at %lld%% (Top: %@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内存占用 %lld%%（最高: %@）"
          }
        }
      }
    },
    "dashboard.action.quota_summary_format": {
      "comment": "Summary format for a CLI quota warning action item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today spend $%.2f / $%.2f cap. Consider routing routine tasks to secondary CLI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日花费 $%.2f / 限额 $%.2f，建议将常规任务分流至备用 CLI。"
          }
        }
      }
    },
    "dashboard.action.quota_title_format": {
      "comment": "Title format for a CLI quota warning action item.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quota at %lld%%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 配额已用 %lld%%"
          }
        }
      }
    },
    "dashboard.action.quota_tokens_summary_format": {
      "comment": "Summary format for a CLI quota warning action item using token counts.",
