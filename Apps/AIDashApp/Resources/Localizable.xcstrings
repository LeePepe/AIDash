        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日活跃 %@ tok · 缓存 %@ tok，建议将常规任务分流至备用 CLI。"
          }
        }
      }
    },
    "dashboard.action.quota_total_summary_format": {
      "comment": "Summary format for a CLI quota warning action item using total token counts.",
