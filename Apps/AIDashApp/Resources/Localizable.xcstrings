      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto (Linear when configured, else Local)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动识别（已配置时使用 Linear，否则本地独立运行）"
          }
        }
      }
    },
    "settings.todo_sync.mode.auto_desc": {
      "comment": "Description for automatic TodoSyncProvider selection.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Linear SSOT when linear-sync.py is installed and falls back to standalone local todos otherwise"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到本机配置 linear-sync.py 时自动启用 Linear SSOT，未安装时自动回退到本地独立模式"
          }
        }
      }
    },
