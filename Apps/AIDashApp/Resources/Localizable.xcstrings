    "settings.telemetry.send_usage_desc": {
      "comment": "Description for the send usage data toggle in Settings.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only anonymous GUI launch duration and briefing view events are recorded; no briefing content or prompts are ever collected."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅记录匿名的界面启动耗时与简报浏览次数，绝不采集任何简报内容或 Prompt。"
          }
        }
      }
    },
    "settings.todo_sync.card_subtitle": {
      "comment": "Subtitle of the pluggable Todo & Issue Sync Integration settings card.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run AIDash 100% standalone with local todos or connect to Linear as a cross-app Single Source of Truth"
          }
