    },
    "settings.todo_sync.mode.linear_desc": {
      "comment": "Description for Linear SSOT sync mode.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Promotes starred proposals to Linear and bidirectionally syncs Done / Todo status with your Linear team"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将星标提案自动建单到 Linear，并与 Linear 团队双向同步完成 / 待办状态"
          }
        }
      }
    },
