#!/usr/bin/env bash
# AIDash pre-push hook.
#
# Lives in scripts/hooks/ under version control. Activated in any
# worktree (or main checkout) by running once:
#
#     git config core.hooksPath scripts/hooks
#
# Resolves changed files to leaf gates. Heavy App/CLI builds remain required in
# CI, where they cannot touch local app-host state. Bypass for emergencies with
# `git push --no-verify`.

set -e
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

remote="$1"
url="$2"

# Read the ref ranges being pushed from stdin.
# Format per line: <local_ref> <local_sha> <remote_ref> <remote_sha>
pushing_anything=0
docs_only=1
zero="0000000000000000000000000000000000000000"

# Captured diff range for the quality gates (require-tests / diff-size).
gate_base=""
gate_head=""
changed_paths=""

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$zero" ] && continue   # delete; skip

    pushing_anything=1

    if [ "$remote_sha" = "$zero" ]; then
        # New branch on remote — compare against merge-base with main.
        base="$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")"
    else
        base="$remote_sha"
    fi

    if [ -z "$base" ]; then
        # Can't compute diff range; be conservative.
        docs_only=0
        continue
    fi

    # Remember the range so the quality gates can inspect this push.
    gate_base="$base"
    gate_head="$local_sha"

    changed_files="$(git diff --name-only "$base..$local_sha")"
    if [ -z "$changed_files" ]; then
        continue
    fi
    changed_paths="${changed_paths}${changed_files}
"

    # Anything outside docs/, *.md, .specify/, .github/, scripts/hooks/
    # counts as code.
    while IFS= read -r f; do
        case "$f" in
            docs/*|*.md|.specify/*|.github/*|scripts/hooks/*) ;;
            *) docs_only=0 ;;
        esac
    done <<<"$changed_files"
done

if [ "$pushing_anything" = "0" ]; then
    exit 0
fi

# The recursive audit is the routing anti-rot gate. Resolve every changed path
# before deciding which local gates apply; no hook-local layer registry exists.
scripts/context/audit >/dev/null
layers=""
while IFS= read -r file; do
    [ -z "$file" ] && continue
    layer="$(scripts/context/resolve --format layer "$file")"
    [ -z "$layer" ] || layers="${layers}${layer}
"
done <<< "$(printf '%s' "$changed_paths" | sed '/^$/d' | sort -u)"
layers="$(printf '%s' "$layers" | sed '/^$/d' | sort -u)"

if [ "$docs_only" = "1" ]; then
    echo "[pre-push] docs-only push; routing audit passed."
    exit 0
fi

# Quality gates — require-tests (blocking) + diff-size (advisory).
# Only run when we have a concrete diff range for this push.
if [ -n "$gate_base" ] && [ -n "$gate_head" ]; then
    if [ -x "scripts/quality/check-diff-size.sh" ]; then
        scripts/quality/check-diff-size.sh "$gate_base" "$gate_head" || true
    fi
    if [ -x "scripts/quality/require-tests.sh" ]; then
        echo "[pre-push] require-tests gate..."
        if ! scripts/quality/require-tests.sh "$gate_base" "$gate_head"; then
            echo "[pre-push] FAILED: require-tests"
            exit 1
        fi
    fi
fi

# Review-gate tests — the Swift scope resolver that keeps the automated
# review gates from raising modifier-attachment blockers off an ambiguous
# hunk (MY-1402). Only runs when this push touches scripts/ci/**.
#
# Picks the first interpreter that actually has pytest: on macOS the system
# python3 carries it while a Homebrew python3 (PEP 668) usually does not, so
# probing `python3` alone would silently skip this gate on most dev machines.
if [ -n "$gate_base" ] && [ -n "$gate_head" ]; then
    if git diff --name-only "$gate_base..$gate_head" | grep -q '^scripts/ci/'; then
        review_py=""
        for candidate in python3 /usr/bin/python3; do
            if command -v "$candidate" >/dev/null 2>&1 \
                    && "$candidate" -c "import pytest" >/dev/null 2>&1; then
                review_py="$candidate"
                break
            fi
        done
        if [ -n "$review_py" ]; then
            echo "[pre-push] pytest (scripts/ci review gate, $review_py)..."
            if ! (cd "$REPO_ROOT/scripts/ci" && "$review_py" -m pytest tests/ -q) \
                    > /tmp/aidash-pre-push-review-gate.log 2>&1; then
                echo "[pre-push] FAILED: review-gate pytest"
                tail -40 /tmp/aidash-pre-push-review-gate.log
                exit 1
            fi
        else
            echo "[pre-push] WARNING: no python3 with pytest; skipping review-gate tests (CI enforces them)."
        fi
    fi
fi

# Lint gate — full-repo swiftlint with the root config (single source of
# truth shared by pre-commit and CI). Fails fast, before the slow build.
# Graceful skip if swiftlint is not installed locally (CI enforces it).
if [ -f "$REPO_ROOT/.swiftlint.yml" ]; then
    if command -v swiftlint >/dev/null 2>&1; then
        echo "[pre-push] swiftlint (root config)..."
        if ! swiftlint lint --strict --quiet --config "$REPO_ROOT/.swiftlint.yml" \
                > /tmp/aidash-pre-push-lint.log 2>&1; then
            echo "[pre-push] FAILED: swiftlint"
            tail -40 /tmp/aidash-pre-push-lint.log
            exit 1
        fi
    else
        echo "[pre-push] WARNING: swiftlint not installed; skipping lint gate (CI enforces it)."
    fi
fi

# Run only local gates declared by affected leaves. Package leaves provide SPM
# build/test gates. App, CLI, and workspace leaves deliberately expose their
# heavy xcodebuild/xcodegen gates to CI only.
while IFS= read -r layer; do
    [ -z "$layer" ] && continue
    scripts/context/run "$layer" --mode local
done <<< "$layers"

echo "[pre-push] all checks passed."
exit 0
