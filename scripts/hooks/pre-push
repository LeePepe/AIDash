#!/usr/bin/env bash
# AIDash pre-push hook.
#
# Lives in scripts/hooks/ under version control. Activated in any
# worktree (or main checkout) by running once:
#
#     git config core.hooksPath scripts/hooks
#
# Resolves changed files to leaf gates. Heavy App/CLI builds remain required in
# CI, where they cannot touch local app-host state. Bypass for emergencies with
# `git push --no-verify`.

set -e
set -o pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

remote="$1"
url="$2"

# Read the ref ranges being pushed from stdin.
# Format per line: <local_ref> <local_sha> <remote_ref> <remote_sha>
pushing_anything=0
zero="0000000000000000000000000000000000000000"

# Keep every pushed range. A hook invocation can update multiple refs, and
# require-tests/review gating must inspect each ref rather than only the last.
ranges_file="$(mktemp "${TMPDIR:-/tmp}/aidash-pre-push-ranges.XXXXXX")"
paths_file="$(mktemp "${TMPDIR:-/tmp}/aidash-pre-push-paths.XXXXXX")"
trap 'rm -f "$ranges_file" "$paths_file"' EXIT

resolve_new_branch_base() {
    local head="$1"
    local preferred_ref=""
    local candidate_ref=""
    local base=""
    local roots=""

    if [ -n "$remote" ]; then
        preferred_ref="refs/remotes/$remote/main"
        if git show-ref --verify --quiet "$preferred_ref"; then
            base="$(git merge-base "$head" "$preferred_ref" 2>/dev/null || true)"
            if [ -n "$base" ]; then
                printf '%s\n' "$base"
                return 0
            fi
        fi
    fi

    while IFS= read -r candidate_ref; do
        case "$candidate_ref" in
            refs/remotes/*/main) ;;
            *) continue ;;
        esac
        [ "$candidate_ref" = "$preferred_ref" ] && continue

        base="$(git merge-base "$head" "$candidate_ref" 2>/dev/null || true)"
        if [ -n "$base" ]; then
            printf '%s\n' "$base"
            return 0
        fi
    done < <(git for-each-ref --format='%(refname)' refs/remotes)

    roots="$(git rev-list --max-parents=0 "$head" 2>/dev/null || true)"
    while IFS= read -r base; do
        if [ -n "$base" ]; then
            printf '%s\n' "$base"
            return 0
        fi
    done <<< "$roots"

    return 1
}

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "$local_sha" ] && continue
    [ "$local_sha" = "$zero" ] && continue   # delete; skip

    pushing_anything=1

    if [ "$remote_sha" = "$zero" ]; then
        # New remote branch — prefer its main, then any tracked main, then root.
        base="$(resolve_new_branch_base "$local_sha" || true)"
    else
        base="$remote_sha"
    fi

    if [ -z "$base" ]; then
        echo "[pre-push] FAILED: cannot compute diff base for $local_ref ($local_sha)" >&2
        exit 1
    fi

    printf '%s %s\n' "$base" "$local_sha" >> "$ranges_file"
    git diff --name-only --diff-filter=ACMRD "$base..$local_sha" >> "$paths_file"
done

if [ "$pushing_anything" = "0" ]; then
    exit 0
fi

# The recursive audit is the routing anti-rot gate. Resolve every changed path
# before deciding which local gates apply; no hook-local layer registry exists.
scripts/context/audit >/dev/null
layers=""
if [ -s "$paths_file" ]; then
    layers="$(sed '/^$/d' "$paths_file" | sort -u | scripts/context/layers --stdin)"
fi

# Quality gates — require-tests (blocking) + diff-size (advisory) — run for
# every pushed ref range.
while IFS=' ' read -r gate_base gate_head; do
    [ -z "$gate_base" ] && continue
    if [ -x "scripts/quality/check-diff-size.sh" ]; then
        scripts/quality/check-diff-size.sh "$gate_base" "$gate_head" || true
    fi
    if [ -x "scripts/quality/require-tests.sh" ]; then
        echo "[pre-push] require-tests gate..."
        if ! scripts/quality/require-tests.sh "$gate_base" "$gate_head"; then
            echo "[pre-push] FAILED: require-tests"
            exit 1
        fi
    fi
done < "$ranges_file"

# Lint only deduplicated, existing Swift files changed across all pushed refs.
# --force-exclude applies the root config's included/excluded paths even when
# files are passed explicitly. CI retains the full-repo lint scan.
swift_paths=()
while IFS= read -r changed_path; do
    case "$changed_path" in
        *.swift)
            if [ -f "$changed_path" ]; then
                swift_paths+=("$changed_path")
            fi
            ;;
    esac
done < <(sort -u "$paths_file")

if [ "${#swift_paths[@]}" -gt 0 ] && [ -f "$REPO_ROOT/.swiftlint.yml" ]; then
    if command -v swiftlint >/dev/null 2>&1; then
        echo "[pre-push] swiftlint (changed Swift files, root config)..."
        if ! swiftlint lint --strict --quiet --force-exclude \
                --config "$REPO_ROOT/.swiftlint.yml" "${swift_paths[@]}" \
                > /tmp/aidash-pre-push-lint.log 2>&1; then
            if grep -q "No lintable files found" /tmp/aidash-pre-push-lint.log; then
                echo "[pre-push] swiftlint: no lintable files after config exclusions; skipping."
            else
                echo "[pre-push] FAILED: swiftlint"
                tail -40 /tmp/aidash-pre-push-lint.log
                exit 1
            fi
        fi
    else
        echo "[pre-push] WARNING: swiftlint not installed; skipping lint gate (CI enforces it)."
    fi
fi

# Run only local gates declared by affected leaves. RepoInfra owns resolver,
# review-gate, and hook checks; package leaves provide SPM build/test gates.
# App, CLI, and workspace heavy xcodebuild/xcodegen gates remain CI-only.
while IFS= read -r layer; do
    [ -z "$layer" ] && continue
    scripts/context/run "$layer" --mode local
done <<< "$layers"

echo "[pre-push] all checks passed."
exit 0
