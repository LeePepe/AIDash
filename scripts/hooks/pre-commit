#!/usr/bin/env bash
# AIDash pre-commit hook — resolver-driven incremental gates.
#
# Resolve staged leaves, run their local gates, and lint staged Swift. Package
# leaves provide SPM build/test gates; heavy App/CLI builds stay in required CI.
#
# 装法(每个 worktree 一次):
#     git config core.hooksPath scripts/hooks
#
# Gate failures are structured as {layer,path,kind,detail,red_lines}.
# 逃生:纯 docs/非包改动自动跳过;紧急可 `git commit --no-verify`
# (但 CI 仍会拦——不可跳过的门在服务端)。

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -z "$staged" ] && exit 0

# Context integrity and path ownership are fast enough to enforce per commit.
scripts/context/audit >/dev/null || exit 1

# Resolve staged paths through the recursive context tree. Gate availability is
# leaf metadata; this hook contains no package-name/path registry.
layers=""
while IFS= read -r file; do
    [ -z "$file" ] && continue
    layer="$(scripts/context/resolve --format layer "$file")" || exit 1
    [ -z "$layer" ] || layers="${layers}${layer}
"
done <<< "$staged"
layers="$(printf '%s' "$layers" | sed '/^$/d' | sort -u)"

if [ -z "$layers" ]; then
    echo "[pre-commit] no routed leaf changes."
else
    fail=0
    while IFS= read -r layer; do
        [ -z "$layer" ] && continue
        if ! scripts/context/run "$layer" --mode local; then
            fail=1
        fi
    done <<< "$layers"

    if [ "$fail" -ne 0 ]; then
        echo ""
        echo "[pre-commit] 修复后重新 commit。勿用 --no-verify 绕过(CI 照样拦)。"
        echo "[pre-commit] resolve the failed path and fix only its owning leaf."
        exit 1
    fi
fi

# lint-staged:只对暂存的 .swift 跑 swiftlint(装了才跑)
#
# NOTE: `swiftlint lint <explicit-file>` IGNORES the config's `excluded:`
# globs — that filtering only applies when SwiftLint discovers files itself.
# So we must apply the same exclusions here, or test idioms (try! / force
# unwrap / fileprivate) that `.swiftlint.yml` deliberately exempts under
# `**/Tests` would be flagged. Read the excluded path segments straight from
# the config so the two never drift.
if command -v swiftlint >/dev/null 2>&1; then
    swift_staged="$(echo "$staged" | grep '\.swift$' || true)"
    # Path segments SwiftLint is configured to exclude (e.g. Tests, .build),
    # extracted from the `excluded:` block of .swiftlint.yml (strip the
    # leading **/ and any trailing /** so we match on the segment name).
    excluded_segs="$(awk '/^excluded:/{f=1;next} /^[^[:space:]-]/{f=0} f && /^[[:space:]]*-/{sub(/#.*/,""); gsub(/[",]/,""); gsub(/\*\*\//,""); gsub(/\/\*\*/,""); gsub(/^[[:space:]]*-[[:space:]]*/,""); gsub(/[[:space:]]+$/,""); print}' "$REPO_ROOT/.swiftlint.yml" || true)"
    if [ -n "$swift_staged" ] && [ -n "$excluded_segs" ]; then
        while IFS= read -r seg; do
            [ -z "$seg" ] && continue
            swift_staged="$(echo "$swift_staged" | grep -v "/${seg}/" | grep -v "^${seg}/" || true)"
        done <<< "$excluded_segs"
    fi
    if [ -n "$swift_staged" ]; then
        echo "[pre-commit] swiftlint(暂存的 .swift,已排除 tests/.build)..."
        lint_fail=0
        while IFS= read -r f; do
            [ -f "$f" ] || continue
            swiftlint lint --strict --quiet --config "$REPO_ROOT/.swiftlint.yml" "$f" || lint_fail=1
        done <<< "$swift_staged"
        [ "$lint_fail" -eq 0 ] || { echo "[pre-commit] ❌ swiftlint 失败"; exit 1; }
    fi
fi

echo "[pre-commit] all checks passed."
exit 0
